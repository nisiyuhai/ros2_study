<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find zzs_description)/urdf/common_intertial.xacro"/>
    <xacro:macro name="wheel_xacro" params="wheel_name xyz">
        <!-- 机器人的IMU部件，惯性测量传感器 -->
            <link name="${wheel_name}_link">
                <!-- 部件的外部描述 -->
                <visual>
                    <!-- 沿着自己几何中心的偏移和旋转量 -->
                    <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/>
                    <!-- 几何形状 -->
                    <geometry>
                        <cylinder radius="0.032" length="0.04"/>
                    </geometry>
                    <!-- 材质颜色 - 引用顶层定义的材质 -->
                    <material name="yellow"/>
                </visual>

                <!-- ★★★ 新增：碰撞体 ★★★ -->
                <collision>
                    <origin xyz="0.0 0.0 0.0" rpy="1.57079 0.0 0.0"/>
                    <geometry>
                        <cylinder radius="0.032" length="0.04"/>
                    </geometry>
                </collision>

                <xacro:cylinder_inertia m="0.05" r="0.032" h="0.04"/>
            </link>

        <joint name="${wheel_name}_joint" type="continuous">
            <origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
            <parent link="base_link"/>
            <child link="${wheel_name}_link"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>

        <gazebo reference="${wheel_name}_link">
            <!-- 切向摩擦系数 -->
            <mu1 value="20.0"/>
            <!-- 法向摩擦系数 -->
            <mu2 value="20.0"/>
            <!-- 接触刚度系数 -->  
            <kp value="1000000000.0"/>
            <!-- 阻尼系数 -->
            <kd value="1.0"/>
        </gazebo>

    </xacro:macro>
    
</robot>